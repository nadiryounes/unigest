# Local PostgreSQL (Docker/local development)
POSTGRES_DB=unigest
POSTGRES_USER=unigest
POSTGRES_PASSWORD=unigest
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=unigest
DATABASE_USER=unigest
DATABASE_PASSWORD=unigest

# Cloud PostgreSQL. When set, DATABASE_URL takes precedence over the fields above.
# Supabase: copy the Session pooler or direct connection string from Project > Connect.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Optional: base64-encoded Supabase CA certificate. If set, certificate verification is enabled.
DATABASE_SSL_CA_BASE64=

JWT_SECRET=change-me-in-production
API_PORT=4000

# Seeding. Demo accounts/data are enabled by default only outside NODE_ENV=production.
DEMO_SEED_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Administrateur
BOOTSTRAP_ADMIN_LAST_NAME=UniGest
DB_SYNCHRONIZE=false

# Exact frontend origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000

# File storage: local or supabase
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback (deprecated by Supabase):
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=candidate-documents

# Password recovery. Resend is optional in local development but required
# if production users must receive reset links by email.
PASSWORD_RESET_WEB_URL=http://localhost:3000/reset-password
RESEND_API_KEY=
EMAIL_FROM=
# Test-only: never enable in production.
PASSWORD_RESET_EXPOSE_TOKEN=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
