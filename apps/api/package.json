{
  "name": "@unigest/api",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/data-source.ts",
    "migration:run:prod": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:show:prod": "npm run typeorm -- migration:show -d src/data-source.ts",
    "start:cloud": "node dist/main.js",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:coverage": "jest --config jest.config.js --coverage --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^22.18.6",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^5.9.2",
    "ts-node": "^10.9.2",
    "@nestjs/testing": "^11.2.6",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.5"
  },
  "engines": {
    "node": "22.x"
  }
}
